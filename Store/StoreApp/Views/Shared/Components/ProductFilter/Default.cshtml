<div class="my-3">
	<h6 class="lead">
		<i class="fa fa-filter text-secondary"></i>
		Filters
	</h6>
</div>

<div class="my-2">
	@* form GET methodu olduğu için Sayfa refresh edildiğinde sorgu kaybolmaz. *@
	<form method="get" asp-action="Index">

		@* QueryString'deki "categoryId" kaybolmuyor. *@
		<input type="hidden" name="categoryId" value="@(Context.Request.Query["categoryId"])" />

		<div class="form-group my-2">
			<input class="form-control" type="text" name="SearchTerm" placeholder="Search" />
		</div>

		<div class="form-group my-2">
			<input class="form-control" type="text" name="MinPrice" placeholder="Min. Price" />
		</div>

		<div class="form-group my-2">
			<input class="form-control" type="text" name="MaxPrice" placeholder="Max. Price" />
		</div>

		<div class="form-group my-2">
			<button type="submit" class="btn btn-sm btn-primary">
				Filter
			</button>
		</div>
	</form>
</div>