@model ProductListViewModel

@section Footer {
	<div>
		Only For Index Footer
	</div>
}

<div class="row my-3">
	<div class="col-md-3">
		@await Component.InvokeAsync(name: "CategoriesMenu")
		@await Component.InvokeAsync("ProductFilter")
		<div products="" number-product="4"></div>
	</div>

	<div class="col-md-9">
		<div class="row my-3">
			@foreach (Product product in Model.Products)
			{
				<partial name="_ProductCard" model="@product" />
			}
		</div>

		<div>
			<div pagination="@Model.Pagination" 
				page-action="Index"
				class="btn-group" 
				page-classes-enabled="true" 
				page-class="btn"
				page-class-normal="btn-outline-dark"
				page-class-selected="btn-primary">
			</div>
		</div>
	</div>
</div>