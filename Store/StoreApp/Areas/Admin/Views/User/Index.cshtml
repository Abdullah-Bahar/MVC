@model IEnumerable<IdentityUser>

<div class="text-center">
	<div class="display-6 my-5">
		Users
	</div>

	<div class="d-flex justify-content-end">
		<a asp-action="Create" class="btn btn-outline-success">
			<i class="fa fa-solid fa-plus"></i>
			Add User
		</a>
	</div>

	<table class="w-100">
		<thead>
			<tr>
				<th>Id</th>
				<th>UserName</th>
				<th>Roles</th>
				<th>Operations</th>
			</tr>
		</thead>
		<tbody>
			@foreach (IdentityUser user in Model)
			{
				<tr>
					<td>@user.Id</td>
					<td>@user.UserName</td>
					<td>-</td>
					<td>
						<div class="btn-group">
							<a asp-action="Update" asp-route-id="@user.UserName" class="btn btn-warning rounded-0">
								Edit
							</a>
							<a asp-action="ResetPassword" asp-route-id="@user.UserName" class="btn btn-info rounded-0">
								Reset Password
							</a>
							<form method="post" asp-action="DeleteOneUser">
								<input type="hidden" name="UserName" value="@user.UserName">
								<button type="submit" class="btn btn-danger rounded-0">
									Delete
								</button>
							</form>
						</div>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
