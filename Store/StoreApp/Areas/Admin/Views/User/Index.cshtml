@model IEnumerable<IdentityUser>

<div class="text-center">
	<div class="display-6 my-5">
		Users
	</div>

	<table class="w-100">
		<thead>
			<tr>
				<th>Id</th>
				<th>UserName</th>
				<th>Roles</th>
				<th>Operations</th>
			</tr>
		</thead>
		<tbody>
			@foreach (IdentityUser user in Model)
			{
				<tr>
					<td>@user.Id</td>
					<td>@user.UserName</td>
					<td>-</td>
					<td>
						<div class="btn-group">
							<a class="btn btn-sm btn-warning">
								Edit
							</a>
							<a class="btn btn-sm btn-info">
								Reset Password
							</a>
							<a class="btn btn-sm btn-danger">
								Delete
							</a>
						</div>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
