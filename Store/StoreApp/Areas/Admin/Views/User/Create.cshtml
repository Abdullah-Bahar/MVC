@model UserDtoForCreation

<div class="display-6 my-5">
	Create Users
</div>

<form method="post" asp-action="Create">
	<div class="row">
		<div class="col-md-6">
			<div class="form-group my-3">
				<label asp-for="UserName"></label>
				<input asp-for="UserName" class="form-control" />
			</div>

			<div class="form-group my-3">
				<label asp-for="Email"></label>
				<input asp-for="Email" class="form-control" />
			</div>

			<div class="form-group my-3">
				<label asp-for="Password"></label>
				<input asp-for="Password" class="form-control" />
			</div>

			<div class="form-group my-3">
				<label asp-for="PhoneNumber"></label>
				<input asp-for="PhoneNumber" class="form-control" />
			</div>

			<div class="form-group my-3">
				<div class="btn-group d-flex justify-content-end">
					<input type="submit" class="btn btn-primary">
				</input>
				<a asp-action="Index" class="btn btn-secondary">Back</a>
			</div>
		</div>
	</div>
	<div class="col-md-6">
		<div class="lead p-2  mt-2">
			Roles
			@foreach (var role in Model.Roles)
			{
				<div class="form-check.my-2">
					<input type="checkbox" id="Roles-@role" name="Roles" value="@role" class="form-check-input" />
					<label class="form-check-label" for="Roles-@role">@role</label>
				</div>
			}
		</div>
	</div>
</div>
</form>
