@model IEnumerable<Product>

<div class="text-center">
	<div class="display-6">
		Products
	</div>

	<div class="d-flex justify-content-end my-3">
		<a class="btn btn-outline-success" asp-action="Create">
			<i class="fa fa-plus"></i>
			Create
		</a>
	</div>

	<table class="table table-striped table-hover">
		<thead>
			<tr>
				<th>Id</th>
				<th>Image Url</th>
				<th>Product Name</th>
				<th>Price</th>
				<th>Operations</th>
			</tr>
		</thead>
		<tbody>
			@foreach (Product product in Model)
			{
				<tr>
					<td>@product.ProductId</td>
					<td>
						<img src="@product.ImageUrl" alt="@product.ProductName" width="50" height="50" class="rounded-circle">
					</td>
					<td>@product.ProductName</td>
					<td>@product.Price.ToString("c")</td>
					<td>
						<div class="btn-group">
							<a class="btn btn-warning" asp-action="Update" asp-route-id="@product.ProductId"
							data-toogle="tooltip" placement="top" title="Edit">
								<i class="fa fa-edit"></i>
							</a>
							<a class="btn btn-info" target="_blank" asp-area="" asp-controller="Product" asp-action="Get"
								asp-route-id="@product.ProductId"
								data-toogle="tooltip" placement="top" title="Info">
								<i class="fa fa-search"></i>
							</a>
							<a class="btn btn-danger" asp-action="Delete" asp-route-id="@product.ProductId"
							data-toogle="tooltip" placement="top" title="Delete">
								<i class="fa fa-trash"></i>
							</a>
						</div>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

@section Scripts {
	<script type="text/javascript">
		$(document).ready(() => {
			$('[data-toogle="tooltip"]').tooltip();
		});
	</script>
}